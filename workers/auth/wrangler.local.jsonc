{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "diveatlas-auth-local",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "GOOGLE_REDIRECT_URI": "http://localhost:8787/api/auth/google/callback"
  },
  "assets": {
    "directory": "../../_site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diveatlas-auth-local",
      // Keep accidental --remote use from ever targeting the production D1 database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
