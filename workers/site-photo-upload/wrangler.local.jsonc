{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "diveatlas-site-photo-upload-local",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "LOCAL_APP_ORIGIN": "http://localhost:8787"
  },
  "r2_buckets": [
    {
      // Local-only private object storage emulator.
      "binding": "SITE_PHOTOS_BUCKET",
      "bucket_name": "diveatlas-user-photo-submissions-local"
    }
  ],
  "d1_databases": [
    {
      // Shared local auth database, read by the session validator.
      "binding": "AUTH_DB",
      "database_name": "diveatlas-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    },
    {
      // Separate local database for photo submission and review metadata.
      "binding": "SITE_PHOTOS_DB",
      "database_name": "diveatlas-site-photos-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ]
}
